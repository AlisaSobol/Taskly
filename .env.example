# Direct connection — used for migrations/seeding (yarn db:migrate, yarn db:seed)
DATABASE_URL=postgres://postgres@127.0.0.1:5433/nuxt3_app

# Pooled connection — used by the running app. On managed providers (e.g. Neon), use
# the pooled/PgBouncer connection string here to avoid exhausting connection limits.
# Falls back to DATABASE_URL when unset.
# DATABASE_URL_POOLED=
