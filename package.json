{
  "name": "nuxt-3-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:start": "pg_ctl -D .data/postgres -l .data/postgres.log -o \"-p 5433 -k /tmp\" start",
    "db:stop": "pg_ctl -D .data/postgres stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env --import tsx server/database/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx server/database/seed.ts",
    "db:studio": "node --env-file=.env node_modules/.bin/drizzle-kit studio"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "1.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.1",
    "pg": "^8.23.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "sass-embedded": "^1.100.0",
    "tsx": "^4.23.15"
  }
}
